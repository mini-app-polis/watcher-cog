# watcher-cog — the names this cog reads. Names only: the values live in
# Doppler (mini-app-polis-ecosystem / dev locally, prd deployed). Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default. In production the Lambda gets these
# from SSM (secrets) and its function environment, both declared in
# mini-app-polis/infra.

# Service account credentials JSON as a string (not a file path)
GOOGLE_CREDENTIALS_JSON=
# Healthchecks.io ping URL e.g. https://hc-ping.com/your-uuid
HEALTHCHECKS_URL_WATCHER=
# Sentry DSN for error tracking
# SENTRY_DSN_COGS=
# DEBUG | INFO (default) | WARNING
# LOGGING_LEVEL=INFO

# The Drive folders the watchers list (src/watcher_cog/config.py).
CSV_SOURCE_FOLDER_ID=
NOTES_INPUT_FOLDER_ID=
GOOGLE_DRIVE_VOICE_INBOX_FOLDER_ID=

# Which environment this process is in. Doppler sets it per config:
# development in dev, so a local run under `doppler run` suppresses every
# trigger and the heartbeat. The Lambda function sets ENVIRONMENT=production
# itself (mini-app-polis/infra).
# ENVIRONMENT=development

# Base URL of api-kaianolevine-com. Production reads the unsuffixed name,
# every other environment reads the _DEV one, and there is no fallback
# between them: a dev process with this unset stops posting findings
# rather than posting them to production.
KAIANO_API_BASE_URL=
KAIANO_API_BASE_URL_DEV=

# This cog's own API key, used to authenticate run reports. Without it
# post_run_finding raises before the request is built and no finding is
# ever delivered — the shape of the September evaluator-cog outage.
WATCHER_COG_API_KEY=

# Per-effect overrides for outbound calls a non-production process must
# not make. Unset is correct in both deployed environments: production
# enables them by resolution, development suppresses them. Set one to
# true only for a deliberate end-to-end test, and remove it afterwards.
# HEALTHCHECKS_ENABLED=
